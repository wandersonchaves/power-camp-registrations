# -------------------------------------------------------
# 🌍 Application
# -------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# -------------------------------------------------------
# 🗄 Database
# -------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# -------------------------------------------------------
# 🔐 NextAuth
# -------------------------------------------------------
NEXTAUTH_SECRET=your-super-secret-here
NEXTAUTH_URL=http://localhost:3000

# -------------------------------------------------------
# 🔎 Google OAuth / SEO
# -------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SITE_VERIFICATION_ID=

# -------------------------------------------------------
# 💳 EFI / Pix
# -------------------------------------------------------
# Ambiente: HMG (homologação) | PRD (produção)
EFI_ENV=HMG

# Opcional → normalmente definido automaticamente pelo client
# EFI_BASE_URL=https://pix-h.api.efipay.com.br

EFI_CLIENT_ID=your-efi-client-id
EFI_CLIENT_SECRET=your-efi-client-secret

# Chave Pix cadastrada na Efí
EFI_PIX_KEY=your-pix-key

# -------------------------------------------------------
# 🔑 Certificados mTLS (EFI)
# -------------------------------------------------------
# Caminhos locais (Docker/PRD podem variar)
EFI_CERT_PEM_PATH=./certs/efi-cert.pem
EFI_CERT_KEY_PEM_PATH=./certs/efi-key.pem

# Opcional (se seu certificado exigir)
EFI_CERT_PASSPHRASE=

# -------------------------------------------------------
# ⏱ Defaults / Tuning
# -------------------------------------------------------
# Expiração padrão de cobranças imediatas (segundos)
EFI_DEFAULT_COB_EXP_SECONDS=3600

# -------------------------------------------------------
# 🔔 Webhooks (EFI)
# -------------------------------------------------------
# Segredo HMAC configurado no painel Efí
EFI_WEBHOOK_HMAC=your-webhook-hmac-secret

# Opcional → lista de IPs permitidos (se usar whitelist)
# EFI_WEBHOOK_ALLOW_IPS=1.2.3.4,5.6.7.8

# true → ignora validação mTLS (somente se necessário / debug)
EFI_WEBHOOK_SKIP_MTLS=false

# -------------------------------------------------------
# 🔗 Internal / Shared Webhooks
# -------------------------------------------------------
WEBHOOK_SHARED_SECRET=

# -------------------------------------------------------
# 🏕 PowerCamp / Business Rules
# -------------------------------------------------------
POWERCAMP_EVENT_ID=
POWERCAMP_OWNER_USER_ID=

# Totais configuráveis (inteiros)
POWERCAMP_ANTECIPADA_TOTAL=
POWERCAMP_LOTE_ZERO_TOTAL=

# -------------------------------------------------------
# 🧪 Optional (Build / CI)
# -------------------------------------------------------
# true → pula validação do env (ex.: pipelines Docker)
# SKIP_ENV_VALIDATION=true