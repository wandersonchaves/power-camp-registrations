generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamCode {
  AGUIA
  LEAO
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  ACTIVE
  PAID
  CANCELLED
  FAILED
  EXPIRED
}

enum UserRole {
  ADMIN
  USER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isActive      Boolean   @default(false)
  role          UserRole  @default(USER) // ✅ novo
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  participants Participant[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id        String   @id @default(cuid())
  name      String
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  recurrences  PixAutoRecurrence[]
  pixAutoLocRecs PixAutoLocRec[]
  pixCobImmediates PixCobImmediate[]
  enrollments Enrollment[]
  teamMilestones TeamMilestone[]
  teamAwards TeamAward[]
}

model Participant {
  id     String @id @default(cuid())
  eventId  String
  userId String
  fullName String
  cpf      String
  email    String?
  phone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event               @relation(fields: [eventId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrences PixAutoRecurrence[]
  pixAutoLocRecs PixAutoLocRec[]
  pixCobImmediates PixCobImmediate[]
  enrollments Enrollment[]

  @@unique([eventId, cpf])
  @@index([eventId])
}

model PixAutoRecurrence {
  id            String @id @default(cuid())
  eventId       String
  participantId String

  // Efí
  idRec         String?   @unique
  status        String
  valorRec      String
  periodicidade String
  dataInicial   DateTime
  dataFinal     DateTime?
  contrato      String
  objeto        String?

  // Location / QR
  locId         Int?
  locationUrl   String?
  pixCopiaECola String?
  jornada       String?

  // idempotência do seu sistema (evita duplicar rec)
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event             @relation(fields: [eventId], references: [id])
  participant   Participant       @relation(fields: [participantId], references: [id])
  solicitations PixAutoSolicRec[]
  charges       PixAutoCobr[]

  @@index([eventId])
  @@index([participantId])
  @@index([status])
}

model PixAutoSolicRec {
  id           String @id @default(cuid())
  recurrenceId String

  // Efí
  idSolicRec    String?  @unique
  status        String
  dataExpiracao DateTime

  // Destinatário (pagador)
  agencia String
  conta   String
  cpf     String
  ispb    String

  // snapshot/auditoria
  recPayload Json?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurrence PixAutoRecurrence @relation(fields: [recurrenceId], references: [id])

  @@index([recurrenceId])
  @@index([status, dataExpiracao])
}

model PixAutoCobr {
  id           String @id @default(cuid())
  recurrenceId String

  // Efí
  txid           String?  @unique
  status         String
  dataVencimento DateTime
  valorOriginal  String
  infoAdicional  String?

  ajusteDiaUtil       Boolean @default(false)
  politicaRetentativa String?

  // idempotência para criação de cobrança
  idempotencyKey String @unique

  // payload/auditoria (opcional)
  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurrence PixAutoRecurrence @relation(fields: [recurrenceId], references: [id])

  @@index([recurrenceId])
  @@index([status])
  @@index([dataVencimento])
}

model EfiWebhookEvent {
  id         String   @id @default(cuid())
  kind       String   // 'webhookrec' | 'webhookcobr'
  externalId String   // hash do payload para idempotência
  payload    Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([kind, externalId], name: "kind_externalId")
  @@index([kind, receivedAt])
}

model PixAutoLocRec {
  id          String   @id @default(cuid())
  eventId     String
  participantId String?

  // Efí
  locId       Int      @unique
  locationUrl String
  criacao     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event       @relation(fields: [eventId], references: [id])
  participant Participant? @relation(fields: [participantId], references: [id])

  @@index([eventId])
  @@index([participantId])
}

model PixCobImmediate {
  id            String   @id @default(cuid())
  eventId       String
  participantId String?

  // Efí
  txid          String?  @unique
  status        String
  valorOriginal String
  criadoEm      DateTime?

  // idempotência local
  idempotencyKey String  @unique

  // auditoria
  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id])
  participant Participant? @relation(fields: [participantId], references: [id])

  @@index([eventId])
  @@index([participantId])
  @@index([status])
}

model Team {
  id        String   @id @default(cuid())
  code      TeamCode @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  teamMilestones TeamMilestone[]
  teamAwards TeamAward[]
}

model Enrollment {
  id            String           @id @default(cuid())
  eventId       String
  participantId String
  teamId        String?          // ✅ agora opcional

  status        EnrollmentStatus @default(PENDING)
  reservedAt    DateTime         @default(now())
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event       @relation(fields: [eventId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])
  team        Team?       @relation(fields: [teamId], references: [id]) // ✅ opcional

  initialPayment InitialPaymentAttempt?

  @@unique([eventId, participantId])
  // ✅ índices com teamId opcional: mantemos, mas sem depender de teamId sempre existir
  @@index([eventId, status])
  @@index([teamId, status])
}

model InitialPaymentAttempt {
  id             String   @id @default(cuid())
  enrollmentId   String   @unique

  // Efí cobrança imediata (Jornada 3)
  txid           String?
  status         PaymentStatus
  createdAtEfi  DateTime?
  paidAt        DateTime?

  amount         String
  payload        Json     @default("{}")

  idempotencyKey String   @unique

  createdAt      DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([status, paidAt])
}

model TeamMilestone {
  id        String   @id @default(cuid())
  eventId   String
  teamId    String
  milestone Int      // ex.: 50

  achievedAt DateTime
  enrollmentId String
  txid        String

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])

  @@unique([eventId, teamId, milestone])
  @@index([eventId, milestone, achievedAt])
}

model TeamAward {
  id        String   @id @default(cuid())
  eventId   String
  awardKey  String   // ex.: "FIRST_50_PAID"
  winnerTeamId String

  pointsGranted Int
  decidedAt DateTime

  // auditoria
  decidedByRule String
  tieBreakNote  String?

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  winnerTeam Team @relation(fields: [winnerTeamId], references: [id])

  @@unique([eventId, awardKey])
  @@index([eventId, decidedAt])
}