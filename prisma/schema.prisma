generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  isActive      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          UserRole      @default(USER)
  accounts      Account[]
  participants  Participant[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id               String              @id @default(cuid())
  name             String
  year             Int
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  enrollments      Enrollment[]
  participants     Participant[]
  pixAutoLocRecs   PixAutoLocRec[]
  recurrences      PixAutoRecurrence[]
  pixCobImmediates PixCobImmediate[]
  teamAwards       TeamAward[]
  teamMilestones   TeamMilestone[]
}

model Participant {
  id               String              @id @default(cuid())
  eventId          String
  userId           String
  fullName         String
  cpf              String
  email            String?
  phone            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  enrollments      Enrollment[]
  event            Event               @relation(fields: [eventId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixAutoLocRecs   PixAutoLocRec[]
  recurrences      PixAutoRecurrence[]
  pixCobImmediates PixCobImmediate[]

  @@unique([eventId, cpf])
  @@index([eventId])
  @@index([userId])
}

model PixAutoRecurrence {
  id             String            @id @default(cuid())
  eventId        String
  participantId  String
  idRec          String?           @unique
  status         String
  valorRec       String
  periodicidade  String
  dataInicial    DateTime
  dataFinal      DateTime?
  contrato       String
  objeto         String?
  locId          Int?
  locationUrl    String?
  pixCopiaECola  String?
  jornada        String?
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payload        Json?
  firstCobTxid   String?           @unique
  charges        PixAutoCobr[]
  migration      PixAutoMigration?
  event          Event             @relation(fields: [eventId], references: [id])
  participant    Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  solicitations  PixAutoSolicRec[]

  @@index([eventId])
  @@index([participantId])
  @@index([status])
}

model PixAutoSolicRec {
  id             String            @id @default(cuid())
  recurrenceId   String
  idSolicRec     String?           @unique
  status         String
  dataExpiracao  DateTime
  agencia        String
  conta          String
  cpf            String
  ispb           String
  recPayload     Json?
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  inputPayload   Json?
  payload        Json?
  recurrence     PixAutoRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  @@index([recurrenceId])
  @@index([status, dataExpiracao])
}

model PixAutoCobr {
  id                  String            @id @default(cuid())
  recurrenceId        String
  txid                String?           @unique
  status              String
  dataVencimento      DateTime
  valorOriginal       String
  infoAdicional       String?
  ajusteDiaUtil       Boolean           @default(false)
  politicaRetentativa String?
  idempotencyKey      String            @unique
  payload             Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdAtEfi        DateTime?
  endToEndId          String?
  paidAt              DateTime?
  competencia         String?
  recurrence          PixAutoRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, competencia])
  @@index([recurrenceId])
  @@index([status])
  @@index([dataVencimento])
  @@index([paidAt])
}

model EfiWebhookEvent {
  id          String    @id @default(cuid())
  kind        String
  externalId  String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([kind, externalId], name: "kind_externalId")
  @@index([kind, receivedAt])
}

model PixAutoLocRec {
  id            String       @id @default(cuid())
  eventId       String
  participantId String?
  locId         Int          @unique
  locationUrl   String
  criacao       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  event         Event        @relation(fields: [eventId], references: [id])
  participant   Participant? @relation(fields: [participantId], references: [id])

  @@index([eventId])
  @@index([participantId])
}

model PixCobImmediate {
  id             String       @id @default(cuid())
  eventId        String
  participantId  String?
  txid           String?      @unique
  status         String
  valorOriginal  String
  criadoEm       DateTime?
  idempotencyKey String       @unique
  payload        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  event          Event        @relation(fields: [eventId], references: [id])
  participant    Participant? @relation(fields: [participantId], references: [id])

  @@index([eventId])
  @@index([participantId])
  @@index([status])
}

model Team {
  id             String          @id @default(cuid())
  code           TeamCode        @unique
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  enrollments    Enrollment[]
  teamAwards     TeamAward[]
  teamMilestones TeamMilestone[]
}

model Enrollment {
  id             String                 @id @default(cuid())
  eventId        String
  participantId  String
  teamId         String?
  status         EnrollmentStatus       @default(PENDING)
  reservedAt     DateTime               @default(now())
  confirmedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  event          Event                  @relation(fields: [eventId], references: [id])
  participant    Participant            @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team           Team?                  @relation(fields: [teamId], references: [id])
  initialPayment InitialPaymentAttempt?

  @@unique([eventId, participantId])
  @@index([eventId, status])
  @@index([teamId, status])
  @@index([participantId])
}

model InitialPaymentAttempt {
  id             String        @id @default(cuid())
  enrollmentId   String        @unique
  txid           String
  status         PaymentStatus
  createdAtEfi   DateTime?
  paidAt         DateTime?
  amount         String
  payload        Json          @default("{}")
  idempotencyKey String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  endToEndId     String?
  enrollment     Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([status, paidAt])
  @@index([txid])
  @@index([endToEndId])
}

model TeamMilestone {
  id           String   @id @default(cuid())
  eventId      String
  teamId       String
  milestone    Int
  achievedAt   DateTime
  enrollmentId String
  txid         String
  createdAt    DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id])
  team         Team     @relation(fields: [teamId], references: [id])

  @@unique([eventId, teamId, milestone])
  @@index([eventId, milestone, achievedAt])
}

model TeamAward {
  id            String   @id @default(cuid())
  eventId       String
  awardKey      String
  winnerTeamId  String
  pointsGranted Int
  decidedAt     DateTime
  decidedByRule String
  tieBreakNote  String?
  createdAt     DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id])
  winnerTeam    Team     @relation(fields: [winnerTeamId], references: [id])

  @@unique([eventId, awardKey])
  @@index([eventId, decidedAt])
}

model PixAutoMigration {
  id            String              @id @default(cuid())
  status        MigrationStatus     @default(PENDING_CONSENT)
  recurrenceId  String              @unique
  consentQrCode String?
  attempts      Int                 @default(0)
  lastError     Json?
  metadata      Json?
  generatedAt   DateTime?
  sentAt        DateTime?
  acceptedAt    DateTime?
  lastCheckedAt DateTime?           @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  auditLogs     MigrationAuditLog[]
  recurrence    PixAutoRecurrence   @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  @@index([status, lastCheckedAt])
}

model MigrationAuditLog {
  id          String           @id @default(cuid())
  migrationId String
  action      String
  payload     Json?
  userEmail   String?
  createdAt   DateTime         @default(now())
  migration   PixAutoMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)
}

enum TeamCode {
  AGUIA
  LEAO
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  ACTIVE
  PAID
  CANCELLED
  FAILED
  EXPIRED
}

enum UserRole {
  ADMIN
  USER
}

enum MigrationStatus {
  PENDING_CONSENT
  QR_GENERATED
  SENT
  CONSENT_ACCEPTED
  CONSENT_REJECTED
  FAILED
  CANCELED
}
