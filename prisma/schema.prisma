generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  participants Participant[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id        String   @id @default(cuid())
  name      String
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  recurrences  PixAutoRecurrence[]
}

model Participant {
  id       String  @id @default(cuid())
  eventId  String
  userId   String
  fullName String
  cpf      String
  email    String?
  phone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event               @relation(fields: [eventId], references: [id])
  user        User                @relation(fields: [userId], references: [id])
  recurrences PixAutoRecurrence[]

  @@unique([eventId, cpf])
  @@index([eventId])
}

model PixAutoRecurrence {
  id            String @id @default(cuid())
  eventId       String
  participantId String

  // Efí
  idRec         String?   @unique
  status        String
  valorRec      String
  periodicidade String
  dataInicial   DateTime
  dataFinal     DateTime?
  contrato      String
  objeto        String?

  // Location / QR
  locId         Int?
  locationUrl   String?
  pixCopiaECola String?
  jornada       String?

  // idempotência do seu sistema (evita duplicar rec)
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event             @relation(fields: [eventId], references: [id])
  participant   Participant       @relation(fields: [participantId], references: [id])
  solicitations PixAutoSolicRec[]
  charges       PixAutoCobr[]

  @@index([eventId])
  @@index([participantId])
  @@index([status])
}

model PixAutoSolicRec {
  id           String @id @default(cuid())
  recurrenceId String

  // Efí
  idSolicRec    String?  @unique
  status        String
  dataExpiracao DateTime

  // Destinatário (pagador)
  agencia String
  conta   String
  cpf     String
  ispb    String

  // snapshot/auditoria
  recPayload Json?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurrence PixAutoRecurrence @relation(fields: [recurrenceId], references: [id])

  @@index([recurrenceId])
  @@index([status, dataExpiracao])
}

model PixAutoCobr {
  id           String @id @default(cuid())
  recurrenceId String

  // Efí
  txid           String?  @unique
  status         String
  dataVencimento DateTime
  valorOriginal  String
  infoAdicional  String?

  ajusteDiaUtil       Boolean @default(false)
  politicaRetentativa String?

  // idempotência para criação de cobrança
  idempotencyKey String @unique

  // payload/auditoria (opcional)
  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recurrence PixAutoRecurrence @relation(fields: [recurrenceId], references: [id])

  @@index([recurrenceId])
  @@index([status])
  @@index([dataVencimento])
}

model EfiWebhookEvent {
  id          String    @id @default(cuid())
  kind        String // "rec" | "cobr"
  externalId  String // se não existir, use hash do payload
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([kind, externalId])
  @@index([kind, receivedAt])
}
